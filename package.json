{
  "name": "@api3/data-feed-proxy-combinators",
  "version": "0.3.0",
  "private": false,
  "description": "Contracts to read, combine or adapt data feeds",
  "license": "MIT",
  "repository": "github:api3dao/data-feed-proxy-combinators",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build:hardhat": "hardhat build",
    "build": "pnpm build:hardhat && tsc -p tsconfig.build.json",
    "coverage": "hardhat test --coverage",
    "deploy:InverseApi3ReaderProxyV1": "hardhat deploy --network $NETWORK --tags InverseApi3ReaderProxyV1",
    "deploy:NormalizedApi3ReaderProxyV1": "hardhat deploy --network $NETWORK --tags NormalizedApi3ReaderProxyV1",
    "deploy:PriceCappedApi3ReaderProxyV1": "hardhat deploy --network $NETWORK --tags PriceCappedApi3ReaderProxyV1",
    "deploy:ProductApi3ReaderProxyV1": "hardhat deploy --network $NETWORK --tags ProductApi3ReaderProxyV1",
    "deploy:ScaledApi3FeedProxyV1": "hardhat deploy --network $NETWORK --tags ScaledApi3FeedProxyV1",
    "eslint:check": "eslint --report-unused-disable-directives --cache . --max-warnings 0",
    "eslint:fix": "pnpm run eslint:check --fix",
    "lint:solhint": "solhint \"./contracts/**/*.sol\"",
    "lint": "pnpm run prettier:check && pnpm run eslint:check && pnpm run lint:solhint",
    "prettier:check": "prettier --check \"./**/*.{js,ts,md,json,sol}\"",
    "prettier": "prettier --write \"./**/*.{js,ts,md,json,sol}\"",
    "release:tag": "tsx scripts/tag-and-release.ts",
    "test": "hardhat test",
    "tsc": "tsc --project tsconfig.json --noEmit",
    "verify-vendor-contracts": "tsx scripts/verify-vendor-contracts.ts"
  },
  "files": [
    "contracts",
    "dist",
    "typechain-types"
  ],
  "keywords": [
    "api3",
    "data feed",
    "oracle",
    "oev"
  ],
  "devDependencies": {
    "@api3/commons": "^2.0.0",
    "@api3/contracts": "^43.0.0",
    "@api3/eslint-plugin-commons": "^4.0.0",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@rocketh/deploy": "^0.19.21",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "chai": "^6.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "ethers": "^6.17.0",
    "glob": "^13.0.6",
    "hardhat": "^3.16.0",
    "hardhat-deploy": "^2.0.26",
    "prettier": "^3.9.10",
    "prettier-plugin-solidity": "^2.4.1",
    "rocketh": "^0.21.0",
    "solhint": "^6.2.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
